		i2s3_plat:i2s3_plat@2903000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02903000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S3>;
			clocks		= <&ccu CLK_BUS_I2S3_APB>,
					  <&ccu CLK_PLL_PERI0_200M>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_I2S3>;
			clock-names	= "clk_bus_i2s",
					  "clk_pll_peri0_200m",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_i2s";
			dmas		= <&dma 6>, <&dma 6>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s3_mach:i2s3_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s3";
			soundcard-mach,format		= "i2s";
			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s3_plat>;
			};
			soundcard-mach,codec {
			};
		};

		g2d: g2d@5440000 {
			compatible = "allwinner,sunxi-g2d";
			reg = <0x0 0x05440000 0x0 0x30000>;
			interrupts = <GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_G2D_AHB>, <&ccu CLK_G2D>;
			clock-names = "ahb_g2d", "g2d";
			resets = <&ccu RST_BUS_G2D>;
			iommus = <&mmu_aw 4 1>;
			assigned-clocks = <&ccu CLK_G2D>;
			assigned-clock-rates = <300000000>;
		};

		psci {
			compatible = "arm,psci-1.0";
			method = "smc";
		};

		timer0: timer0@3208000{
			compatible = "allwinner,hstimer-v100";
			device_type = "timer0";
			reg = <0x0 0x03208000 0x0 0x400>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "parent", "bus", "timer0-mod", "timer1-mod";
			clocks = <&dcxo24M>, <&ccu CLK_BUS_TIMER0_AHB>, <&ccu CLK_TIMER0_0>, <&ccu CLK_TIMER0_1>;
			resets = <&ccu RST_BUS_TIMER0>;
		};

		pcie: pcie@c800000 {
			#address-cells = <3>;
			#size-cells = <2>;
			compatible = "allwinner,sun65iw1-pcie", "snps,dw-pcie";
			device_type = "pci";
			reg = <0x0 0x0c800000 0x0 0x00100000>,
			      <0x0 0x0c900000 0x0 0x00040000>,
			      <0x0 0x0cb00000 0x0 0x00080000>,
			      <0x0 0x0cb80000 0x0 0x00080000>,
			      <0x0 0x0cc00000 0x0 0x00080000>,
			      <0x4 0x40000000 0x0 0x01000000>;
			reg-names = "dbi", "dbi2", "atu", "dma", "app", "config";
			ranges = <0x01000000 0x4 0x41000000 0x4 0x41000000 0x0 0x01000000>, /* downstream I/O (16 MB) */
				 <0x02000000 0x0 0x22000000 0x4 0x42000000 0x0 0x08000000>, /* non-prefetchable memory (128 MB) */
				 <0x43000000 0x4 0x4a000000 0x4 0x4a000000 0x0 0xf6000000>; /* prefetchable memory (3936 MB) */
			clocks = <&ccu CLK_PCIE0_AUX>, <&ccu CLK_PCIE0_AXI_S>;
			clock-names = "aux", "axi_slv";
			assigned-clocks = <&ccu CLK_PCIE0_AXI_S>;
			assigned-clocks-parents = <&ccu CLK_PLL_PERI0_400M>;
			assigned-clock-rates = <400000000>;
			resets = <&ccu RST_BUS_PCIE0>, <&ccu RST_BUS_PCIE0_PWR_UP>;
			reset-names = "rst", "pwrup_rst";
			power-domains = <&pd SUN65IW1_PCK_HSI>;
			interrupts = <GIC_SPI 194 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 187 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "sii", "msi",
					  "dma0", /* edma-w */
					  "dma1"; /* edma-r */
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie_intc 0>,
					<0 0 0 2 &pcie_intc 1>,
					<0 0 0 3 &pcie_intc 2>,
					<0 0 0 4 &pcie_intc 3>;
			bus-range = <0x0 0xff>;
			linux,pci-domain = <0>;
			max-link-speed = <2>;
			num-lanes = <1>;
			phys = <&combo0_pcie>;
			phy-names = "pcie-phy";
			status = "disabled";

			pcie_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
			};
		};

		gmac_stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0xf>;
			snps,rd_osr_lmt = <0xf>;
			snps,blen = <256 128 64 32 16 8 4>;
		};

		gmac_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <1>;
			queue0 {};
		};

		gmac_mtl_tx_setup: tx_queues-config {
			snps,tx-queues-to-use = <1>;
			queue0 {};
		};

		gmac0: ethernet@de00000 {
			compatible = "allwinner,sunxi-gmac-110", "snps,dwmac-5.20";
			reg = <0x0 0x0de00000 0x0 0x8000>, /* ip */
				  <0x0 0x0de08000 0x0 0x1000>; /* cfg */
			interrupts = <GIC_SPI 170 IRQ_TYPE_LEVEL_HIGH>,
						<GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "tx0_irq", "rx0_irq";
			clocks = <&ccu CLK_GMAC0_AXI>, <&ccu CLK_BUS_GMAC0_AHB>, <&ccu CLK_GMAC0_PHY>,
					<&ccu CLK_HSI_AXI>, <&ccu CLK_BUS_HSI_AHB>, <&ccu CLK_BUS_HSI_AXI>;
			clock-names = "stmmaceth", "pclk", "phy", "nsi", "hsi_ahb", "hsi_axi";
			assigned-clocks = <&ccu CLK_HSI_AXI>, <&ccu CLK_GMAC0_PHY>;
			assigned-clock-parents = <&ccu CLK_PLL_PERI0_480M>;
			assigned-clock-rates = <480000000>, <25000000>;
			resets = <&ccu RST_BUS_GMAC0_AXI>, <&ccu RST_BUS_GMAC0_AHB>, <&ccu RST_BUS_HSI_SY>;
			reset-names = "stmmaceth", "ahb", "hsi";
			phy-mode = "rgmii";
			phy-handle = <&gmac0_phy0>;
			power-domains = <&pd SUN65IW1_PCK_HSI>;
			status = "disabled";

			snps,fixed-burst;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;

			mdio0: mdio0@0 {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
				gmac0_phy0: ethernet-phy@0 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x1>;
					max-speed = <1000>;  /* Max speed capability */
					reset-gpios = <&pio PA 14 GPIO_ACTIVE_LOW>;
					/* PHY datasheet rst time */
					reset-assert-us = <10000>;
					reset-deassert-us = <150000>;
				};
			};
		};

		vind0: vind@4800800 {
			compatible = "allwinner,sunxi-vin-media", "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			device_id = <0>;
			csi_top = <336000000>;
			csi_isp = <327000000>;
			reg = <0x0 0x04800800 0x0 0x200>,
				<0x0 0x04800000 0x0 0x800>,
				<0x0 0x04810000 0x0 0x100>;
			interrupts = <GIC_SPI 220 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_CSI>, <&ccu CLK_PLL_VIDEO2_4X>,
				<&ccu CLK_CSI_MASTER0>, <&dcxo24M>, <&ccu CLK_PLL_VIDEO1_4X>,
				<&ccu CLK_CSI_MASTER1>, <&dcxo24M>, <&ccu CLK_PLL_VIDEO1_4X>,
				<&ccu CLK_CSI_MASTER2>, <&dcxo24M>, <&ccu CLK_PLL_VIDEO1_4X>,
				<&ccu CLK_ISP>, <&ccu CLK_PLL_VIDEO0_4X>,
				<&ccu CLK_BUS_VIDEO_IN_AHB>, <&ccu CLK_BUS_VIDEO_IN_AHB_SW>,
				<&ccu CLK_CIS_MBUS>, <&ccu CLK_ISP_MBUS>, <&ccu CLK_MBUS_VIDEO_IN>;
			clock-names = "csi_top", "csi_top_src",
						"csi_mclk0", "csi_mclk0_24m", "csi_mclk0_pll",
						"csi_mclk1", "csi_mclk1_24m", "csi_mclk1_pll",
						"csi_mclk2", "csi_mclk2_24m", "csi_mclk2_pll",
						"csi_isp", "csi_isp_src",
						"csi_bus", "vid_in_ahb",
						"csi_mbus", "csi_isp_mbus", "vid_in_mbus";
			resets = <&ccu RST_BUS_VIDEO_IN>;
			reset-names = "csi_ret";
			pinctrl-names = "mclk0-default", "mclk0-sleep", "mclk1-default", "mclk1-sleep",
							"mclk2-default", "mclk2-sleep";
			pinctrl-0 = <&csi_mclk0_pins_a>;
			pinctrl-1 = <&csi_mclk0_pins_b>;
			pinctrl-2 = <&csi_mclk1_pins_a>;
			pinctrl-3 = <&csi_mclk1_pins_b>;
			pinctrl-4 = <&csi_mclk2_pins_a>;
			pinctrl-5 = <&csi_mclk2_pins_b>;
			power-domains = <&pd SUN65IW1_PCK_VI>;
			status = "okay";

			csi0: csi@4820000 {
				compatible = "allwinner,sunxi-csi";
				reg = <0x0 0x04820000 0x0 0x1000>;
				interrupts = <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-names = "default","sleep";
				pinctrl-0 = <&ncsi_bt656_pins_a>;
				pinctrl-1 = <&ncsi_bt656_pins_b>;
				device_id = <0>;
				status = "okay";
			};
			csi1: csi@4821000 {
				compatible = "allwinner,sunxi-csi";
				reg = <0x0 0x04821000 0x0 0x1000>;
				interrupts = <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>;
				device_id = <1>;
				status = "okay";
			};
			csi2: csi@4822000 {
				compatible = "allwinner,sunxi-csi";
				reg = <0x0 0x04822000 0x0 0x1000>;
				interrupts = <GIC_SPI 212 IRQ_TYPE_LEVEL_HIGH>;
				device_id = <2>;
				status = "okay";
			};

			mipi0: mipi@4810100 {
				compatible = "allwinner,sunxi-mipi";
				reg = <0x0 0x04810100 0x0 0x100>,
					<0x0 0x04811000 0x0 0x400>,
					<0x0 0x03408240 0x0 0x10>,
					<0x0 0x03200174 0x0 0x10>;
				interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-names = "mipi0-default","mipi0-sleep";
				pinctrl-0 = <&mipia_pins_a>;
				pinctrl-1 = <&mipia_pins_b>;
				device_id = <0>;
				status = "okay";
			};
			mipi1: mipi@4810200 {
				compatible = "allwinner,sunxi-mipi";
				reg = <0x0 0x04810200 0x0 0x100>,
					<0x0 0x04811400 0x0 0x400>;
				pinctrl-names = "mipi1-default","mipi1-sleep";
				pinctrl-0 = <&mipib_pins_a>;
				pinctrl-1 = <&mipib_pins_b>;
				pinctrl-2 = <&mipic_4lane_pins_a>;
				pinctrl-3 = <&mipic_4lane_pins_b>;
				device_id = <1>;
				status = "okay";
			};
			mipi2: mipi@4810300 {
				compatible = "allwinner,sunxi-mipi";
				reg = <0x0 0x04810300 0x0 0x100>,
					<0x0 0x04811800 0x0 0x400>;
				pinctrl-names = "mipi2-default","mipi2-sleep";
				pinctrl-0 = <&mipic_pins_a>;
				pinctrl-1 = <&mipic_pins_b>;
				device_id = <2>;
				status = "okay";
			};

			tdm0: tdm@4908000 {
				compatible = "allwinner,sunxi-tdm";
				reg = <0x0 0x04908000 0x0 0x400>;
				interrupts = <GIC_SPI 219 IRQ_TYPE_LEVEL_HIGH>;
				work_mode = <0x0>;
				device_id = <0>;
				iommus = <&mmu_aw 0 0>;
				status = "okay";
			};

			isp00:isp@4900000 {
				compatible = "allwinner,sunxi-isp";
				reg = <0x0 0x04900000 0x0 0x1300>;
				interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>;
				work_mode = <0x0>;
