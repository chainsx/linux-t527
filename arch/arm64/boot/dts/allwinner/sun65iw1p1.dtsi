			reg_base = <0x02810000>;
			status = "disabled";
		};

		s_pwm0: pwm@70a0000 {
			#pwm-cells = <0x3>;
			compatible = "allwinner,sunxi-pwm-v204";
			reg = <0x0 0x070a0000 0x0 0x400>;
			clocks = <&r_ccu CLK_R_PWM>,<&r_ccu CLK_BUS_R_PWM>;
			interrupts = <GIC_SPI 243 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "clk_pwm","clk_bus_pwm";
			resets = <&r_ccu RST_BUS_R_PWM>;
			pwm-number = <4>;
			pwm-base = <0x4>;
			sunxi-pwms = <&s_pwm0_0>, <&s_pwm0_1>, <&s_pwm0_2>, <&s_pwm0_3>;
			status = "okay";
		};

		s_pwm0_0: s_pwm0@70a0010 {
			compatible = "allwinner,sunxi-pwm4";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x070a0010 0x0 0x4>;
			reg_base = <0x070a0000>;
			status = "disabled";
		};

		s_pwm0_1: s_pwm0@70a0011 {
			compatible = "allwinner,sunxi-pwm5";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x070a0011 0x0 0x4>;
			reg_base = <0x070a0000>;
			status = "disabled";
		};

		s_pwm0_2: s_pwm0@70a0012 {
			compatible = "allwinner,sunxi-pwm6";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x070a0012 0x0 0x4>;
			reg_base = <0x070a0000>;
			status = "disabled";
		};

