			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s1_plat>;
			};
			soundcard-mach,codec {
			};
		};

		i2s2_plat:i2s2_plat@2902000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02902000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S2>;
			clocks		= <&ccu CLK_BUS_I2S2_APB>,
					  <&ccu CLK_PLL_PERI0_200M>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_I2S2>;
			clock-names	= "clk_bus_i2s",
					  "clk_pll_peri0_200m",
