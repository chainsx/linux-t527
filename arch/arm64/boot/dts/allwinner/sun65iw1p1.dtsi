			compatible = "allwinner,sunxi-pwm7";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x070a0013 0x0 0x4>;
			reg_base = <0x070a0000>;
			status = "disabled";
		};

		dma: dma-controller@3228000 {
			compatible = "allwinner,dma-v111";
			reg = <0x0 0x3228000 0x0 0x2000>;
			interrupts = <GIC_SPI 100 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_DMA0_AHB>, <&ccu CLK_MBUS_DMA0>, <&ccu CLK_DMA0_MBUS_GATE>;
			clock-names = "bus", "mbus", "mbus-en";
			dma-channels = <8>;
			dma-requests = <64>;
			resets = <&ccu RST_BUS_DMA0>;
			#dma-cells = <1>;
		};

		arm_pmu {
			compatible = "arm,armv8-pmuv3";
			interrupts = <GIC_SPI 316 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 317 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 318 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 319 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 348 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 349 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 374 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 375 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>, <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
		};

		dump_reg:dump_reg@44000 {
			compatible = "allwinner,sunxi-dump-reg";
			reg = <0x0 0x00044000 0x0 0x0004>;
			ddr-range = <8>;
		};

		hwspinlock: hwspinlock@3220000 {
			compatible = "allwinner,sunxi-hwspinlock";
			reg = <0x0 0x3220000 0x0 0x1000>;
			#hwlock-cells = <1>;
			clocks = <&ccu CLK_BUS_SPINLOCK_AHB>;
			clock-names = "clk_hwspinlock_bus";
			resets = <&ccu RST_BUS_SPINLOCK>;
			reset-names = "rst";
			num-locks = <32>;
			status = "okay";
		};

		sid: sid@3408000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x0 0x03408000 0x0 0x200>;
			#address-cells = <1>;
			#size-cells = <1>;
			non-secure-maxoffset = <0x50>;
			non-secure-maxlen = <0x10>;

			secure_status {
				offset = <0xa0>;
				size = <0x4>;
			};
			chipid {
				offset = <0x200>;
				size = <0x10>;
			};
			rotpk {
				offset = <0x140>;
				size = <0x20>;
			};

			dvfs_ori {
				offset = <0x214>;
				shift = <16>;
				mask = <0xff>;
			};

			dvfs_bak {
				offset = <0x214>;
				shift = <24>;
				mask = <0xff>;
			};

			res0 {
				offset = <0x240>;
				shift = <24>;
				mask = <0xf>;
			};

			res1 {
				offset = <0x240>;
				shift = <28>;
				mask = <0xf>;
			};
		};

		sram_ctrl: sram_ctrl@3200000 {
			compatible = "allwinner,sram_ctrl";
			reg = <0x0 0x03200000 0 0x184>;
			soc_ver {
				offset = <0x24>;
				mask = <0x7>;
				shift = <0>;
			};
		};

		ths: ths@2818000 {
			compatible = "allwinner,sun65iw1p1-ths";
			reg = <0x0 0x02818000 0x0 0x400>;
			clocks = <&ccu CLK_BUS_TSENSOR_APB>,<&ccu CLK_GPADC0>;
			clock-names = "bus","gpadc";
			resets = <&ccu RST_BUS_TSENSO>;
			#thermal-sensor-cells = <1>;
		};

		sdc2: sdmmc@400A000 {
			compatible = "allwinner,sunxi-mmc-v4p6x";
			device_type = "sdc2";
			reg = <0x0 0x0400A000 0x0 0x1000>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				<&ccu CLK_PLL_PERI1_800M>,
				<&ccu CLK_PLL_PERI1_600M>,
				<&ccu CLK_SMHC2>,
				<&ccu CLK_BUS_SMHC2_AHB>,
				<&ccu CLK_BUS_SMHC2_AHB_SW>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb","mmc_store";
			resets = <&ccu RST_BUS_SMHC2>;
			reset-names = "rst";
			pinctrl-names = "default","sleep";
			pinctrl-0 = <&sdc2_pins_a &sdc2_pins_c &sdc2_pins_d>;
			pinctrl-1 = <&sdc2_pins_b>;
			bus-width = <8>;
			req-page-count = <2>;
			cap-mmc-highspeed;
			cap-cmd23;
			mmc-cache-ctrl;
			non-removable;
			/*max-frequency = <200000000>;*/
			max-frequency = <50000000>;
			cap-erase;
			mmc-high-capacity-erase-size;
			no-sdio;
			no-sd;
			/*-- speed mode --*/
			/*sm0: DS26_SDR12*/
			/*sm1: HSSDR52_SDR25*/
			/*sm2: HSDDR52_DDR50*/
			/*sm3: HS200_SDR104*/
			/*sm4: HS400*/
			/*-- frequency point --*/
			/*f0: CLK_400K*/
			/*f1: CLK_25M*/
			/*f2: CLK_50M*/
			/*f3: CLK_100M*/
			/*f4: CLK_150M*/
			/*f5: CLK_200M*/
			ctl-spec-caps = <0x328>;
			sdc_tm4_sm0_freq0 = <0>;
			sdc_tm4_sm0_freq1 = <0>;
			sdc_tm4_sm1_freq0 = <0x00000000>;
			sdc_tm4_sm1_freq1 = <0>;
			sdc_tm4_sm2_freq0 = <0x00000000>;
			sdc_tm4_sm2_freq1 = <0>;
			sdc_tm4_sm3_freq0 = <0x05000000>;
			sdc_tm4_sm3_freq1 = <0x00000005>;
			sdc_tm4_sm4_freq0 = <0x00050000>;
			sdc_tm4_sm4_freq1 = <0x00000004>;
			sdc_tm4_sm4_freq0_cmd = <0>;
			sdc_tm4_sm4_freq1_cmd = <0>;

			/*vmmc-supply = <&reg_3p3v>;*/
			/*vqmc-supply = <&reg_3p3v>;*/
			/*vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			/*sunxi-power-save-mode;*/
			status = "disabled";
		};

		sdc0: sdmmc@4008000 {
			compatible = "allwinner,sunxi-mmc-v5p3x";
			device_type = "sdc0";
			reg = <0x0 0x04008000 0x0 0x1000>;
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				<&ccu CLK_PLL_PERI1_400M>,
				<&ccu CLK_PLL_PERI1_300M>,
				<&ccu CLK_SMHC0>,
				<&ccu CLK_BUS_SMHC0_AHB>,
				<&ccu CLK_BUS_SMHC0_AHB_SW>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb","mmc_store";
			resets = <&ccu RST_BUS_SMHC0>;
			reset-names = "rst";
			pinctrl-names = "default","mmc_1v8","sleep","uart_jtag";
			pinctrl-0 = <&sdc0_pins_a &sdc0_pins_f>;
			pinctrl-1 = <&sdc0_pins_b &sdc0_pins_g>;
			pinctrl-2 = <&sdc0_pins_c>;
			pinctrl-3 = <&sdc0_pins_d &sdc0_pins_e>;
			max-frequency = <50000000>;
			bus-width = <4>;
			req-page-count = <2>;
			/*non-removable;*/
			/*broken-cd;*/
			/*cd-inverted*/
			/*cd-gpios = <&pio PF 6 GPIO_ACTIVE_LOW>;*/
			/* vmmc-supply = <&reg_3p3v>;*/
			/* vqmc-supply = <&reg_3p3v>;*/
			/* vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			cap-sd-highspeed;
			cap-wait-while-busy;
			/*sd-uhs-sdr50;*/
			/*sd-uhs-ddr50;*/
			/*cap-sdio-irq;*/
			/*keep-power-in-suspend;*/
			/*ignore-pm-notify;*/
			/*sunxi-power-save-mode;*/
			/*sunxi-dly-400k = <1 0 0 0>; */
			/*sunxi-dly-26M  = <1 0 0 0>;*/
			/*sunxi-dly-52M  = <1 0 0 0>;*/
			/*sunxi-dly-52M-ddr4  = <1 0 0 0>;*/
			/*sunxi-dly-52M-ddr8  = <1 0 0 0>;*/
			/*sunxi-dly-104M  = <1 0 0 0>;*/
			/*sunxi-dly-208M  = <1 0 0 0>;*/
			/*sunxi-dly-104M-ddr  = <1 0 0 0>;*/
			/*sunxi-dly-208M-ddr  = <1 0 0 0>;*/
			ctl-spec-caps = <0x408>;
			status = "disabled";
		};

		sdc1: sdmmc@4009000 {
			compatible = "allwinner,sunxi-mmc-v5p3x";
			device_type = "sdc1";
			reg = <0x0 0x04009000 0x0 0x1000>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				 <&ccu CLK_PLL_PERI1_400M>,
				 <&ccu CLK_PLL_PERI1_300M>,
				 <&ccu CLK_SMHC1>,
				 <&ccu CLK_BUS_SMHC1_AHB>,
				 <&ccu CLK_BUS_SMHC1_AHB_SW>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb","mmc_store";
			resets = <&ccu RST_BUS_SMHC1>;
			reset-names = "rst";
			pinctrl-names = "default","sleep";
			pinctrl-0 = <&sdc1_pins_a &sdc1_pins_c>;
			pinctrl-1 = <&sdc1_pins_b>;
			max-frequency = <50000000>;
			bus-width = <4>;
			/*broken-cd;*/
			/*cd-inverted*/
			/*cd-gpios = <&pio PG 6 6 1 2 0>;*/
			/* vmmc-supply = <&reg_3p3v>;*/
			/* vqmc-supply = <&reg_3p3v>;*/
			/* vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			cap-sd-highspeed;
			cap-sdio-irq;
			ignore-pm-notify;
			/*sd-uhs-sdr50;*/
			/*sd-uhs-ddr50;*/
			/*sd-uhs-sdr104;*/
			/*cap-sdio-irq;*/
			keep-power-in-suspend;
			execute_tuning_in_kernel;
			/*ignore-pm-notify;*/
			/*sunxi-power-save-mode;*/
			/*sunxi-dly-400k = <0xff 0xff 0xff 0xff 0xff 0xff>; */
			/*sunxi-dly-26M  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-52M  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-52M-ddr4  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-52M-ddr8  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-104M  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-208M  = <0xff 0xff 0xff 0xff 0xff 0xff> ;*/
			/*sunxi-dly-104M-ddr  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			/*sunxi-dly-208M-ddr  = <0xff 0xff 0xff 0xff 0xff 0xff>;*/
			sunxi-dly-208M  = <0xff 0x1 0xff 0xff 0xff 0xff>;
			ctl-spec-caps = <0x428>;
			status = "disabled";
		};

		wdt: watchdog@3010000 {
			compatible = "allwinner,wdt-v103";
			reg = <0x0 0x03010000 0x0 0x20>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;  /* In GIC Spec */
			sys-24m-clk-select = <1>;
		};

		/*
		 * channel0~3  : cpux -> e902
		 */
		msgbox: msgbox@3210000 {
			compatible = "allwinner,sun65iw1-msgbox";
			#mbox-cells = <1>;
			reg = <0x0 0x03210000 0x0 0x1000>,
			      <0x0 0x03211000 0x0 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_MSGBOX_CPUX_AHB>;
			clock-names = "msgbox";
			resets = <&ccu RST_BUS_MSGBOX_CPUX>;
			reset-names = "rst";
			local_id = <0>;
			status = "okay";
		};

		spi0: spi@2c00000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.3";
			reg = <0x0 0x02c00000 0x0 0x1000>;
			interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI0>, <&ccu CLK_BUS_SPI0_AHB>;
			clock-names = "pll", "mod", "bus";
			resets = <&ccu RST_BUS_SPI0>;
			dmas = <&dma 22>, <&dma 22>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <2>;
			status = "disabled";
		};

		spi1: spi@2c01000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.4";
			reg = <0x0 0x02c01000 0x0 0x1000>;
			interrupts = <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI1>, <&ccu CLK_BUS_SPI1_AHB>;
			clock-names = "pll", "mod", "bus";
			resets = <&ccu RST_BUS_SPI1>;
			dmas = <&dma 23>, <&dma 23>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <1>;
			status = "disabled";
		};

		spi2: spi@2c02000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.3";
			reg = <0x0 0x02c02000 0x0 0x1000>;
			interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI2>, <&ccu CLK_BUS_SPI2_AHB>;
			clock-names = "pll", "mod", "bus";
			resets = <&ccu RST_BUS_SPI2>;
			dmas = <&dma 24>, <&dma 24>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <1>;
			status = "disabled";
		};

		r_spi0: spi@7280000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.3";
			reg = <0x0 0x07280000 0x0 0x1000>;
			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&r_ccu CLK_R_SPI>, <&r_ccu CLK_BUS_R_SPI>;
			clock-names = "pll", "mod", "bus";
			resets = <&r_ccu RST_BUS_R_SPI>;
			dmas = <&dma 62>, <&dma 62>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <1>;
			status = "disabled";
		};

		gpu:gpu@1800000 {
			device_type = "gpu";
			compatible = "arm,mali-valhall";
			reg = <0x0 0x01800000 0x0 0x10000>;
			interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "JOB", "MMU", "GPU";
			clocks = <&ccu CLK_GPU>,
				<&ccu CLK_BUS_GPU_AHB>,
				<&ccu CLK_PLL_GPU>,
				<&ccu CLK_BUS_GPU_AHB_SW>,
				<&ccu CLK_BUS_GPU_AXI>,
				<&ccu CLK_PLL_PERI0_800M>,
				<&ccu CLK_PLL_PERI0_600M>,
				<&ccu CLK_PLL_PERI0_400M>,
				<&ccu CLK_PLL_PERI0_300M>,
				<&ccu CLK_PLL_PERI0_200M>;
			clock-names = "clk_mali", "clk_bus", "clk_parent", "gpu-ahb-gate",
				"gpu-axi-gate", "clk_800", "clk_600", "clk_400", "clk_300",
				"clk_200";
			resets = <&ccu RST_BUS_GPU>, <&ccu RST_BUS_GPU_AXIMON>;
			reset-names = "rst_bus_gpu", "rst_bus_gpu_axi";
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;
			ipa_dvfs:ipa_dvfs {
				compatible = "arm,mali-simple-power-model";
				static-coefficient = <636>;
				dynamic-coefficient = <1434>;
				/* ts0 -> ts3 */
				ts = <0xcc77c0 217000 0xffffd508 200>;
				thermal-zone = "gpu_thermal_zone";
				/*ss-coefficient = <36>;*/
				/*ff-coefficient = <291>;*/
			};
			/*power-domains = <&pd1 A523_PCK_GPU>;*/
		};

		sunxi_drm: sunxi-drm {
			compatible = "allwinner,sunxi-drm";
			fb_base = <0>;
			status = "okay";
		};

		de: de@5000000 {
			compatible = "allwinner,display-engine-v355";
			iommus = <&mmu_aw 5 1>;
			reg = <0x0 0x5000000 0x0 0x400000>;
			interrupts = <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_DE>,
				 <&ccu CLK_BUS_DE0_AHB>,
				 <&ccu CLK_MBUS_DE_SYS>;
			clock-names = "clk_de",
				      "clk_ahb_de",
				      "clk_bus_de";
			resets = <&ccu RST_BUS_DE0>;
			reset-names = "rst_bus_de";
			assigned-clocks = <&ccu CLK_DE>;
			assigned-clock-parents = <&ccu CLK_PLL_PERI0_480M>;
			assigned-clock-rates = <480000000>;
			power-domains = <&pd SUN65IW1_PCK_VO>;
			sys = <&vo0>;
			status = "disabled";
			operating-points-v2 = <&de_opp_table>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				disp0: port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					disp0_out_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_in_disp0>;
					};
					disp0_out_tcon4: endpoint@3 {
						reg = <4>;
						remote-endpoint = <&tcon4_in_disp0>;
					};
				};
				disp1: port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
					disp1_out_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_in_disp1>;
					};
					disp1_out_tcon4: endpoint@3 {
						reg = <4>;
						remote-endpoint = <&tcon4_in_disp1>;
					};
				};
			};
		};

		vo0: vo0@5a00000 {
			compatible = "allwinner,tcon-top0";
			reg = <0x0 0x05a00000 0x0 0xfff>;
			clocks = <&ccu CLK_BUS_VO0_AHB>,
				 <&ccu CLK_BUS_VIDEO_OUT0_AHB_SW>;
			clock-names = "clk_ahb",
				      "clk_ahb_gate";
			resets = <&ccu RST_BUS_VIDEO_OUT0>,
				 <&ccu RST_BUS_VO0>;
			reset-names = "rst_bus_dpss_top",
				       "rst_bus_reg";
			power-domains = <&pd SUN65IW1_PCK_VO>;
			status = "disabled";
		};

		dlcd0: tcon0@5a08000 {
			compatible = "allwinner,tcon-lcd";
			reg = <0x0 0x05a08000 0x0 0x1000>;
			interrupts = <GIC_SPI 154 IRQ_TYPE_LEVEL_HIGH>;

			clocks = <&ccu CLK_BUS_TCON_LCD0_AHB>;
			clock-names = "clk_bus_tcon";
			resets = <&ccu RST_BUS_TCON_LCD0>;
			reset-names = "rst_bus_tcon";
			top = <&vo0>;
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				tcon0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					tcon0_in_disp0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&disp0_out_tcon0>;
					};
					tcon0_in_disp1: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&disp1_out_tcon0>;
					};
				};
				tcon_out: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
					tcon0_out_dsi0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&dsi0_in_tcon0>;
					};
					tcon0_out_lvds0: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&lvds0_in_tcon0>;
					};
					tcon0_out_rgb0: endpoint@2 {
						reg = <2>;
						remote-endpoint = <&rgb0_in_tcon0>;
					};
				};
			};
		};

		dsi0combophy: phy@5a11000 {
			compatible = "allwinner,sunxi-dsi-combo-phy0,sun65iw1";
			reg = <0x0 0x05a11000 0x0 0xfff>;
			clocks = <&ccu CLK_BUS_MIPI_DSI0_AHB>;
			clock-names = "phy_gating_clk";
			resets = <&ccu RST_BUS_MIPI_DSI0>;
			reset-names = "phy_rst_clk";
			#clock-cells = <1>;
			#phy-cells = <0>;
			status = "disabled";
		};

		dsi0: dsi0@5a10000 {
			compatible = "allwinner,dsi0";
			reg = <0x0 0x05a10000 0x0 0xfff>;
			interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_MIPI_DSI0>,
				<&ccu CLK_BUS_MIPI_DSI0_AHB>,
				<&dsi0combophy CLK_DSI_HS>,
				<&dsi0combophy CLK_DSI_LS>;
			clock-names = "dsi_clk",
					"dsi_gating_clk",
					"displl_hs",
					"displl_ls";
			resets = <&ccu RST_BUS_MIPI_DSI0>;
			reset-names = "dsi_rst_clk";
			phys = <&dsi0combophy>;
			phy-names = "combophy";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				dsi0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					dsi0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_dsi0>;
					};
				};
			};
		};

		rgb0: rgb0@1000 {
			compatible = "allwinner,rgb0";
			clocks = <&dsi0combophy CLK_LVDS_OR_RGB>;
			clock-names = "rgb_pclk";
			phys = <&dsi0combophy>;
			phy-names = "combophy0";
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				rgb0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					rgb0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_rgb0>;
					};
				};
			};
		};

		lvds0: lvds0@1000 {
			compatible = "allwinner,lvds0";
			clocks = <&dsi0combophy CLK_LVDS_OR_RGB>;
			clock-names = "lvds_pclk";
			resets = <&ccu RST_BUS_LVDS0>;
			reset-names = "rst_bus_lvds";
			phys = <&dsi0combophy>;
			phy-names = "combophy0";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				lvds0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					lvds0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_lvds0>;
					};
				};
			};
		};

		vo1: vo1@5c00000 {
			compatible = "allwinner,tcon-top1";
			reg = <0x0 0x05c00000 0x0 0xfff>;
			clocks = <&ccu CLK_BUS_VO1_AHB>,
				 <&ccu CLK_BUS_VIDEO_OUT0_AHB_SW>;
			clock-names = "clk_ahb",
				      "clk_ahb_gate";
			resets = <&ccu RST_BUS_VIDEO_OUT0>,
				<&ccu RST_BUS_VO1>;
			reset-names = "rst_bus_dpss_top",
				      "rst_bus_reg";
			status = "disabled";
		};

		tv0: tcon4@5c08000 {
			compatible = "allwinner,tcon-tv";
			reg = <0x0 0x05c08000 0x0 0x1000>;
			interrupts = <GIC_SPI 156 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_TCON_TV0_EDP>,
				<&ccu CLK_BUS_TCON_TV0_AHB>;
			clock-names = "clk_tcon",
					"clk_bus_tcon";
			resets = <&ccu RST_BUS_TCON_TV0>;
			reset-names = "rst_bus_tcon";
			top = <&vo1>;
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				tcon4_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					tcon4_in_disp0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&disp0_out_tcon4>;
					};
					tcon4_in_disp1: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&disp1_out_tcon4>;
					};
				};
				tcon4_out: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
					tcon4_out_edp0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&edp0_in_tcon4>;
					};
					tcon4_out_dp0: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&dp0_in_tcon4>;
					};
				};
			};
		};

		edp0: edp0@5c10000 {
			compatible = "allwinner,drm-edp";
			reg = <0x0 0x05c10000 0x0 0x4000>;
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_EDP_AHB>,
				<&ccu CLK_TCON_TV0_EDP>;
			clock-names = "clk_bus_edp",
				"clk_edp";
			use_inner_clk = <1>;
			resets = <&ccu RST_BUS_EDP>;
			reset-names = "rst_bus_edp";
			/* assigned-clocks = <&ccu CLK_TCON_TV0_EDP>; */
			/* assigned-clock-parents = <&ccu CLK_PLL_VIDEO1_4X>; */
			power-domains = <&pd SUN65IW1_PCK_VO>;
			sys = <&vo1>;
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				edp_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					edp0_in_tcon4: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon4_out_edp0>;
					};
				};
				edp_out: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
				};
			};
		};

		dp0: dp0@5c10000 {
			compatible = "allwinner,drm-dp";
			reg = <0x0 0x05c10000 0x0 0x4000>;
			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_EDP_AHB>,
				<&ccu CLK_TCON_TV0_EDP>;
			clock-names = "clk_bus_edp",
				"clk_edp";
			use_inner_clk = <1>;
			resets = <&ccu RST_BUS_EDP>;
			reset-names = "rst_bus_edp";
			/* assigned-clocks = <&ccu CLK_TCON_TV0_EDP>; */
			/* assigned-clock-parents = <&ccu CLK_PLL_VIDEO1_4X>; */
			power-domains = <&pd SUN65IW1_PCK_VO>;
			sys = <&vo1>;
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				dp_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					dp0_in_tcon4: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon4_out_dp0>;
					};
				};
				dp_out: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
				};
			};
		};

		ce0: ce@3412000 {
			compatible = "allwinner,sunxi-ce";
			device_name = "ce";
			reg = <0x0 0x03412000 0x0 0x800>, /* non-secure space */
				<0x0 0x03412800 0x0 0x800>; /* secure space */
			interrupts = <GIC_SPI 96 IRQ_TYPE_EDGE_RISING>, /*non-secure*/
				<GIC_SPI 97 IRQ_TYPE_EDGE_RISING>; /* secure*/
			clock-frequency = <400000000>; /* 400MHz */
			clocks = <&ccu CLK_BUS_CE_SYS_AXIMON>, <&ccu CLK_BUS_CE_SYS_IP_AHB>, <&ccu CLK_BUS_CE_SYS_AXI>,
				<&ccu CLK_PLL_PERI0_400M>, <&ccu CLK_CE_SYS>;
			clock-names = "bus_ce", "ce_clk", "mbus_ce", "clk_src", "ce_sys_clk";
			resets = <&ccu RST_BUS_CE_SYS_AXIMON>, <&ccu RST_BUS_CE_SY>;
			reset-names = "rst_bus_ce", "rst_ce_clk";
			low-power-mode;
			status = "okay";
		};

		gpadc0: gpadc0@2820000 {
			compatible = "allwinner,sunxi-gpadc-v101";
			reg = <0x0 0x02820000 0x0 0x400>;
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC0_APB>, <&ccu CLK_GPADC0>;
			clock-names = "bus", "hosc";
			resets = <&ccu RST_BUS_GPADC0>;
			status = "disabled";
		};

		ledc: ledc@2830000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-leds";
			reg = <0x0 0x02830000 0x0 0x400>;
			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_LEDC>, <&ccu CLK_BUS_LEDC_APB>;
			clock-names = "clk_ledc", "clk_cpuapb";
			resets = <&ccu RST_BUS_LEDC>;
			reset-names = "ledc_reset";
			dmas = <&dma 12>;
			dma-names = "tx";
			status = "disabled";
		};

		nsi0: nsi-controller@2400000 {
			compatible = "allwinner,sunxi-nsi-v2";
			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0x02400000 0x0 0x10000>,
				  <0x0 0x02410000 0x0 0x400>;
			clocks = <&ccu CLK_PLL_PERI0_600M>, <&ccu CLK_MBUS>,
				<&ccu CLK_NSI>, <&ccu CLK_PLL_PERI0_600M>,
				<&ccu CLK_AHB>, <&drampll_ccu CLK_DFI>;
			clock-names = "pll", "bus", "nsi", "nsi-p","ahb", "cpu_direct";
			resets = <&ccu RST_BUS_NSI>, <&ccu RST_BUS_NSI_CFG>;
			reset-names = "bus_nsi", "bus_nsi_cfg";
			clock-frequency = <600000000>, <600000000>;
			#nsi-cells = <1>;
			clk_path_type = <1>;
			topology_type = <2>;
			channel_type = <1>;
			master_clks = <0 1>, <1 1>, <2 1>, <3 1>, <4 2>, <5 1>, <6 1>, <7 1>,
					<8 1>, <9 2>, <10 1>, <11 1>, <12 2>, <13 4>, <14 4>, <15 4>,
					<16 4>, <17 4>, <18 4>, <22 5>;
			ia_pmu_data_unit = <64>;
			ta_pmu_data_unit = <64>;
			ra_pmu_data_unit = <64>;
			cpu_pmu_data_unit = <64>;
			sub_node_id_mapping;

			cpu{
				id = <19>;
				cpu_direct_reg = <0x02410000 0x010c>;
			};

			iommu{
				id = <6>;
				mode = <0>;
				pri = <3>;
				select = <1>;
			};
			de {
				id = <2>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};
			eink {
				id = <3>;
				mode = <0>;
				pri = <1>;
				select = <1>;
			};
			g2d {
				id = <7>;
				mode = <0>;
				pri = <1>;
				select = <1>;
			};
			ve {
				id = <5>;
				mode = <0>;
				pri = <1>;
				select = <1>;
			};
			isp {
				id = <0>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};
			csi {
				id = <1>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};
			smhc2 {
				id = <18>;
				mode = <0>;
				pri = <2>;
				select = <1>;
			};
		};

		/* audio dirver module -> audio codec */
		codec:codec@2908000 {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-codec";
			reg		= <0x0 0x02908000 0x0 0x348>;
			resets		= <&ccu RST_BUS_AUDIOCODEC0>;
			clocks		= <&ccu CLK_BUS_AUDIOCODEC0_APB>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_AUDIOCODEC0_DAC>,
					  <&ccu CLK_AUDIOCODEC0_ADC>;
			clock-names	= "clk_bus_adda",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_adda_dac",
					  "clk_adda_adc";
			interrupts	= <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		codec_plat:codec_plat {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-aaudio";
			dac-txdata	= <0x02908020>;
			adc-txdata	= <0x02908040>;
			dmas		= <&dma 7>, <&dma 7>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			dma-buf-mode	= <0>;
			status = "disabled";
		};

		codec_mach:codec_mach {
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "audiocodec";
			soundcard-mach,pin-switches	= "MIC1", "MIC2",
							  "LINEOUTL", "LINEOUTR",
							  "HPOUT", "SPK";
			soundcard-mach,routing		= "MIC1P_PIN", "MIC1",
							  "MIC1N_PIN", "MIC1",
							  "MIC2P_PIN", "MIC2",
							  "MIC2N_PIN", "MIC2",
							  "LINEOUTL", "LINEOUTLP_PIN",
							  "LINEOUTL", "LINEOUTLN_PIN",
							  "LINEOUTR", "LINEOUTRP_PIN",
							  "LINEOUTR", "LINEOUTRN_PIN",
							  "SPK", "LINEOUTLP_PIN",
							  "SPK", "LINEOUTLN_PIN",
							  "SPK", "LINEOUTRP_PIN",
							  "SPK", "LINEOUTRN_PIN",
							  "HPOUT", "HPOUTL_PIN",
							  "HPOUT", "HPOUTR_PIN";
			soundcard-mach,jack-support = <1>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&codec_plat>;
			};
			soundcard-mach,codec {
				sound-dai = <&codec>;
				soundcard-mach,pll-fs	= <1>;
			};
		};

		/* audio dirver module -> external-ac203c */
		ac203c_clocks:ac203c_clocks {
			compatible = "allwinner,sunxi-snd-ac203c-clocks";
			resets		= <&ccu RST_BUS_AUDIOCODEC1>;
			clocks		= <&ccu CLK_BUS_AUDIOCODEC1_APB>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_AUDIOCODEC1_DAC>;
			clock-names	= "clk_bus_adda",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_adda_dac";
			status		= "okay";
		};

		ac203c_plat:ac203c_plat {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-aaudio";
			dac-txdata	= <0x02909020>;
			adc-txdata	= <0x02909618>;
			dmas		= <&dma 9>, <&dma 9>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			dma-buf-mode	= <0>;
			status = "disabled";
		};

		ac203c_mach:ac203c_mach {
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "audiocodec";
			soundcard-mach,pin-switches	= "MIC1", "MIC2", "MIC3", "MIC4",
							  "HPOUT", "LINEOUTL", "LINEOUTR", "SPK";
			soundcard-mach,routing	= "MIC1P_PIN", "MIC1",
						  "MIC1N_PIN", "MIC1",
						  "MIC2P_PIN", "MIC2",
						  "MIC2N_PIN", "MIC2",
						  "MIC3P_PIN", "MIC3",
						  "MIC3N_PIN", "MIC3",
						  "MIC4P_PIN", "MIC4",
						  "MIC4N_PIN", "MIC4",
						  "LINEOUTL", "LINEOUTLP_PIN",
						  "LINEOUTL", "LINEOUTLN_PIN",
						  "LINEOUTR", "LINEOUTRP_PIN",
						  "LINEOUTR", "LINEOUTRN_PIN",
						  "SPK", "LINEOUTLP_PIN",
						  "SPK", "LINEOUTLN_PIN",
						  "SPK", "LINEOUTRP_PIN",
						  "SPK", "LINEOUTRN_PIN",
						  "HPOUT", "HPOUT_PIN";
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&ac203c_plat>;
			};
			soundcard-mach,codec {
			};
		};

		/* audio dirver module -> hdmi */
		hdmi_codec:hdmi_codec {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-codec-hdmi";
			status = "disabled";
		};

		/* audio dirver module -> edp */
		edp_codec:edp_codec {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-codec-edp";
			status = "disabled";
		};

		/* audio dirver module -> owa */
		owa_plat:owa_plat@2918000 {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-owa";
			reg		= <0x0 0x02918000 0x0 0x5C>;
			resets		= <&ccu RST_BUS_OWA0>;
			clocks		= <&ccu CLK_BUS_OWA0_APB>,
					  <&ccu CLK_PLL_PERI0_300M>,
					  <&ccu CLK_PLL_PERI0_400M>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_OWA0_TX>,
					  <&ccu CLK_OWA0_RX>;
			clock-names	= "clk_bus_owa",
					  "clk_pll_peri0_300m",
					  "clk_pll_peri0_400m",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_owa_tx",
					  "clk_owa_rx";
			dmas		= <&dma 2>, <&dma 2>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			interrupts	= <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		owa_mach:owa_mach {
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name = "sndowa";
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&owa_plat>;
			};
			soundcard-mach,codec {
			};
		};

		/* audio dirver module -> dmic */
		dmic_plat:dmic_plat@2910000 {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-dmic";
			reg		= <0x0 0x02910000 0x0 0x50>;
			resets		= <&ccu RST_BUS_DMIC>;
			clocks		= <&ccu CLK_BUS_DMIC_APB>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_DMIC>;
			clock-names	= "clk_bus_dmic",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_dmic";
			dmas		= <&dma 8>;
			dma-names	= "rx";
			capture-cma	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		dmic_mach:dmic_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "snddmic";
			soundcard-mach,capture-only;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&dmic_plat>;
			};
			soundcard-mach,codec {
			};
		};

		/* audio dirver module -> I2S/PCM */
		i2s0_plat:i2s0_plat@2900000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02900000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S0>;
			clocks		= <&ccu CLK_BUS_I2S0_APB>,
					  <&ccu CLK_PLL_PERI0_200M>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_I2S0>;
			clock-names	= "clk_bus_i2s",
					  "clk_pll_peri0_200m",
					  "clk_pll_audio0",
					  "clk_pll_audio1_2x",
					  "clk_pll_audio1_5x",
					  "clk_i2s";
			dmas		= <&dma 3>, <&dma 3>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s0_mach:i2s0_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s0";
			soundcard-mach,format		= "i2s";
