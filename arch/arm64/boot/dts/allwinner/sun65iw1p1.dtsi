	ddr_clk: clk_ddr {
		compatible = "allwinner,sun65iw1_clock_ddr";
		reg = <0x0 0x0a030000 0x0 0x1000>,
				<0x0 0x0a011000 0x0 0x1000>;
		clocks = <&drampll_ccu CLK_DFI>,
				<&drampll_ccu CLK_PLL_DDR0>,
				<&drampll_ccu CLK_PLL_DDR1>,
				<&drampll_ccu CLK_PLL_DDR2>;
		clock-names = "dfi_clk", "ddrpll0", "ddrpll1", "ddrpll2";
		#clock-cells = <0>;
	};

	dram_opp_table: opp_table {
		compatible = "operating-points-v2";
		opp@150000000 {
			opp-hz = /bits/ 64 <150000000>;
			clock-latency-ns = <150000>;
			opp-microvolt = <900000>;
		};
	};

	sunxi_dmcfreq: dmcfreq@a010000 {
		compatible = "allwinner,sun65iw1-dmc";
		reg = <0x0 0x0a010000 0x0 0x11000>,
			  <0x0 0x02400000 0x0 0x3000>;
		interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&ddr_clk>,
				<&ccu CLK_NSI>,
				<&drampll_ccu CLK_PLL_DDR0>,
				<&drampll_ccu CLK_PLL_DDR1>,
				<&drampll_ccu CLK_PLL_DDR2>;
		clock-names = "dram", "bus", "ddrpll0", "ddrpll1", "ddrpll2";
		operating-points-v2 = <&dram_opp_table>;
		upthreshold = <30>;
		downdifferential = <15>;
		vddcore-supply = <&reg_vdd_sys>;
		normalvoltage = <900000>;
		boostvoltage = <900000>;
	};

	soc: soc@3000000 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		cpufreq_hw: cpufreq@7010000 {
			compatible = "allwinner,sun65iw1-hw-dvfs";
			reg = <0 0x07010000 0 0x64>, <0 0x07010200 0 0x64>, <0 0x07010100 0 0x64>;
			reg-names = "cluster0-dvfs", "cluster1-dvfs", "cluster2-dvfs";
			clocks = <&cpupll_ccu CLK_PLL_CPU0>, <&cpupll_ccu CLK_PLL_CPU1>, <&cpupll_ccu CLK_PLL_CPU2>;
			#freq-domain-cells = <2>;
			dvfs_twi = <&s_twi0>;
			pmu_addr = <0x35 0x36 0x36>; //0x68 0x6c 0x6c
			pmu_reg_addr = <0x83 0x14 0x13>;
			twi_priority = <0 0 0>;
			twi_mask = <0x80 0x80 0x00>;
			channel = <0 1 2>;
			twi_channel_num = <3>;
			cluster0-supply = <&reg_dcdc1>;
			cluster1-supply = <&reg_axp1530_dcdc2>;
			cluster2-supply = <&reg_axp1530_dcdc1>;
		};

		rtc_ccu: rtc_ccu@7200000 {
			compatible = "allwinner,sun65iw1-rtc-ccu";
			reg = <0x0 0x07200000 0x0 0x400>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		cpupll_ccu: clock@8200000 {
			compatible = "allwinner,sun65iw1-cpupll";
			reg = <0x0 0x08200000 0x0 0x050c>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			pll_step = <0x9>;
			pll_ssc = <0x3300>;
		};

		ccu: ccu@3008000 {
			compatible = "allwinner,sun65iw1-ccu";
			reg = <0x0 0x03008000 0x0 0x2000>;
			clocks = <&dcxo24M>, <&rtc_ccu CLK_OSC32K>, <&rc_16m>;
			clock-names = "hosc", "losc", "iosc";
			#clock-cells = <1>;
			#reset-cells = <1>;
		       /*
			* for example:
			* sdm_info: sdm_info {
			*	pll-video0-parent {
			*		sdm-enable = <1>; // required
			*		sdm-factor = <4>; // required
			*		freq-mode  = <TR_N>; // optional: default TR_N
			*		sdm-freq   = <FREQ_32>; // optional: default FREQ_31_5
			*	};
			* };
			*/
		};

		r_ccu: r_ccu@7030000 {
			compatible = "allwinner,sun65iw1-r-ccu";
			reg = <0x0 0x07030000 0x0 0x230>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		drampll_ccu: drampll_ccu@A030000 {
			compatible = "allwinner,sun65iw1-pll-dram";
			reg = <0x0 0x0A030000 0x0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};


		pd_vo_pwrctl: pd_vo_pwrctl@0 {
			compatible = "allwinner,sunxi-power-domain-power-ctl";
			power-domains = <&pd SUN65IW1_PCK_VO>;
			status = "okay";
		};

		pd_ve_pwrctl: pd_ve_pwrctl@0 {
			compatible = "allwinner,sunxi-power-domain-power-ctl";
			power-domains = <&pd SUN65IW1_PCK_VE>;
			status = "okay";
		};

		pd_vi_pwrctl: pd_vi_pwrctl@0 {
			compatible = "allwinner,sunxi-power-domain-power-ctl";
			power-domains = <&pd SUN65IW1_PCK_VI>;
			status = "okay";
		};

		/*
		pd_hsi_pwrctl: pd_hsi_pwrctl@0 {
			compatible = "allwinner,sunxi-power-domain-power-ctl";
			power-domains = <&pd SUN65IW1_PCK_HSI>;
			status = "okay";
		};
		*/

		ve: ve@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			reg = <0x0 0x01c0e000 0x0 0x1000>,
				  <0x0 0x03200000 0x0 0x10>;
			interrupts = <GIC_SPI 182 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_VE>,
				 <&ccu CLK_MBUS_VE0>,
				 <&ccu CLK_BUS_VE0_AHB_SW>,
				 <&ccu CLK_VE0_MBUS_GATE>,
				 <&ccu CLK_VE0>,
				 <&ccu CLK_BUS_VE0_AHB>;
			clock-names = "pll_ve",
				      "mbus_ve",
				      "ahb_gate",
				      "mbus_gate",
				      "ve",
				      "bus_ve";
			resets = <&ccu RST_BUS_VE0>;
			reset-names = "reset_ve";
			operating-points-v2 = <&ve_opp_table>;
			iommus = <&mmu_aw 2 1>;
			power-domains = <&pd SUN65IW1_PCK_VE>;
		};

		pio: pinctrl@3000000 {
			compatible = "allwinner,sun65iw1-pinctrl";
			reg = <0x0 0x03000000 0x0 0x800>;
			interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_APB1>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;

			sdc0_pins_f: sdc0@5 {
				pins = "PF2";
				function = "sdc0";
				drive-strength = <40>;
				bias-pull-up;
				power-source = <3300>;
			};

			sdc0_pins_g: sdc0@6 {
				pins = "PF2";
				function = "sdc0";
				drive-strength = <40>;
				bias-pull-up;
				power-source = <1800>;
			};

			sdc0_pins_a: sdc0@0 {
				pins = "PF0", "PF1",
						"PF3", "PF4", "PF5";
				function = "sdc0";
				drive-strength = <20>;
				bias-pull-up;
				power-source = <3300>;
			};

			sdc0_pins_b: sdc0@1 {
				pins = "PF0", "PF1",
						"PF3", "PF4", "PF5";
				function = "sdc0";
				drive-strength = <20>;
				bias-pull-up;
				power-source = <1800>;
			};

			sdc0_pins_c: sdc0@2 {
				pins = "PF0", "PF1", "PF2",
				"PF3", "PF4", "PF5";
				function = "gpio_in";
			};

			/* TODO: add jtag pin */
			sdc0_pins_d: sdc0@3 {
				pins = "PF2", "PF4";
				function = "uart0";
				drive-strength = <10>;
				bias-pull-up;
			};

			sdc0_pins_e: sdc0@4 {
				pins = "PF0", "PF1", "PF3",
						"PF5";
				function = "jtag";
				drive-strength = <10>;
				bias-pull-up;
			};

			sdc1_pins_a: sdc1@0 {
				pins = "PG1", "PG2",
						"PG3", "PG4", "PG5";
				function = "sdc1";
				drive-strength = <20>;
				bias-pull-up;
			};

			sdc1_pins_b: sdc1@1 {
				pins = "PG0", "PG1", "PG2",
						"PG3", "PG4", "PG5";
				function = "gpio_in";
			};

			sdc1_pins_c: sdc1@2 {
				pins = "PG0";
				function = "sdc1";
				drive-strength = <40>;
				bias-pull-up;
			};

			sdc2_pins_a: sdc2@0 {
				pins = "PC3",
					"PC4", "PC5", "PC6", "PC7",
					"PC8", "PC9", "PC10", "PC11";
				function = "sdc2";
				drive-strength = <20>;
				bias-pull-up;
			};

			sdc2_pins_b: sdc2@1 {
				pins = "PC0", "PC1", "PC2", "PC3",
						"PC4", "PC5", "PC6", "PC7",
						"PC8", "PC9", "PC10", "PC11";
				function = "gpio_in";
			};

			sdc2_pins_c: sdc2@2 {
				pins = "PC0";
				function = "sdc2";
				drive-strength = <40>;
				bias-pull-down;
			};

			sdc2_pins_d: sdc2@3 {
				pins = "PC1", "PC2";
				function = "sdc2";
				drive-strength = <40>;
				bias-pull-up;
			};

			csi_mclk0_pins_a: csi_mclk0@0 {
				pins = "PE0";
				function = "mcsi0";
				drive-strength = <20>;
			};

			csi_mclk0_pins_b: csi_mclk0@1 {
				pins = "PE0";
				function = "gpio_in";
			};

			csi_mclk1_pins_a: csi_mclk1@0 {
				pins = "PE5";
				function = "mcsi1";
				drive-strength = <20>;
			};

			csi_mclk1_pins_b: csi_mclk1@1 {
				pins = "PE5";
				function = "gpio_in";
			};

			csi_mclk2_pins_a: csi_mclk2@0 {
				pins = "PE15";
				function = "mcsi2";
				drive-strength = <20>;
			};

			csi_mclk2_pins_b: csi_mclk2@1 {
				pins = "PE15";
				function = "gpio_in";
			};

			ncsi_bt656_pins_a: ncsi_BT656@0 {
				pins = "PK10", "PK12", "PK13",
				"PK14", "PK15", "PK16", "PK17",
				"PK18", "PK19", "PK20", "PK21";
				function = "ncsi";
				drive-strength = <20>;
			};

			ncsi_bt656_pins_b: ncsi_BT656@1 {
				pins = "PK10", "PK12", "PK13",
				"PK14", "PK15", "PK16", "PK17",
				"PK18", "PK19", "PK20", "PK21";
				function = "gpio_in";
			};

			ncsi_bt1120_pins_a: ncsi_BT1120@0 {
				pins = "PK10", "PK12", "PK13",
				"PK14", "PK15", "PK16", "PK17",
				"PK18", "PK19", "PK20", "PK21",
				"PE8", "PE9", "PE10", "PE11",
				"PE12", "PE13", "PE14", "PE15";
				function = "ncsi";
				drive-strength = <20>;
			};

			ncsi_bt1120_pins_b: ncsi_BT1120@1 {
				pins = "PK10", "PK12", "PK13",
				"PK14", "PK15", "PK16", "PK17",
				"PK18", "PK19", "PK20", "PK21",
				"PE8", "PE9", "PE10", "PE11",
				"PE12", "PE13", "PE14", "PE15";
				function = "gpio_in";
			};

			mipia_pins_a: mipia@0 {
				pins = "PK0", "PK1", "PK2", "PK3", "PK4", "PK5",
					"PK6", "PK7", "PK8", "PK9";
				function = "mcsia";
				drive-strength = <10>;
			};

			mipia_pins_b: mipia@1 {
				pins = "PK0", "PK1", "PK2", "PK3", "PK4", "PK5",
					"PK6", "PK7", "PK8", "PK9";
				function = "gpio_in";
			};

			mipib_pins_a: mipib@0 {
				pins = "PK10", "PK11", "PK12",
					"PK13", "PK14", "PK15";
				function = "mcsib";
				drive-strength = <10>;
			};

			mipib_pins_b: mipib@1 {
				pins = "PK10", "PK11", "PK12",
					"PK13", "PK14", "PK15";
				function = "gpio_in";
			};

			mipic_pins_a: mipic@0 {
				pins = "PK16", "PK17", "PK18",
					"PK19", "PK20", "PK21";
				function = "mcsic";
				drive-strength = <10>;
			};

			mipic_pins_b: mipic@1 {
				pins = "PK16", "PK17", "PK18",
					"PK19", "PK20", "PK21";
				function = "gpio_in";
			};

			mipic_4lane_pins_a: mipic_4lane@0 {
				pins = "PK16", "PK17", "PK18",
					"PK19", "PK20", "PK21";
				function = "mcsic";
				drive-strength = <10>;
			};

			mipic_4lane_pins_b: mipic_4lane@1 {
				pins = "PK16", "PK17", "PK18",
					"PK19", "PK20", "PK21";
				function = "gpio_in";
			};

			dsi0_4lane_pins_a: dsi0_4lane@0 {
				pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
				function = "dsi0";
				drive-strength = <30>;
				bias-disable;
			};

			dsi0_4lane_pins_b: dsi0_4lane@1 {
				pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
				function = "io_disabled";
				bias-disable;
			};

			lvds0_pins_a: lvds0@0 {
				pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
				function = "lvds0";
				drive-strength = <30>;
			};

			lvds0_pins_b: lvds0@1 {
				pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
				function = "gpio_in";
			};

			lvds1_pins_a: lvds1@0 {
				pins = "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19";
				function = "lvds1";
				drive-strength = <30>;
			};

			lvds1_pins_b: lvds1@1 {
				pins = "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19";
				function = "gpio_in";
			};

			rgb0_24pins_a: rgb0@0 {
				pins = "PH8", "PH9", "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PH10", "PH13", "PD6", "PD7", "PD8", "PD9", \
					"PD10", "PD11", "PH14", "PH15", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", \
					"PD20", "PD21";
				function = "lcd0";
				drive-strength = <30>;
			};

			rgb0_24pins_b: rgb0@1 {
				pins = "PH8", "PH9", "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PH10", "PH13", "PD6", "PD7", "PD8", "PD9", \
					"PD10", "PD11", "PH14", "PH15", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", \
					"PD20", "PD21";
				function = "gpio_in";
			};
		};

		r_pio: pinctrl@7058000 {
			#address-cells = <1>;
			compatible = "allwinner,sun65iw1-r-pinctrl";
			reg = <0x0 0x07058000 0x0 0x200>;
			interrupts = <GIC_SPI 234 IRQ_TYPE_LEVEL_HIGH>, /* GPIOL */
				<GIC_SPI 236 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_R_APB0>, <&dcxo24M>, <&rtc_ccu CLK_OSC32K>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <3>;
			interrupt-controller;
			#interrupt-cells = <3>;
		};

		uart0: uart@2B00000 {
			compatible = "allwinner,uart-v102";
			reg = <0x0 0x02B00000 0x0 0x400>;
			interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_UART0_APB>;
			resets = <&ccu RST_BUS_UART0>;
