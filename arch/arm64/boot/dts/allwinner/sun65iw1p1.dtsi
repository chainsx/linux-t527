			};
			isp01:isp@48ffffc {
				compatible = "allwinner,sunxi-isp";
				reg = <0x0 0x048ffffc 0x0 0x1304>;
				interrupts = <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>;
				work_mode = <0xff>;
