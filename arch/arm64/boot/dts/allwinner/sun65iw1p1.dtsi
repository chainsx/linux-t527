// SPDX-License-Identifier: (GPL-2.0+ or MIT)
#include <dt-bindings/clock/sun65iw1-ccu.h>
#include <dt-bindings/clock/sun65iw1-rtc.h>
#include <dt-bindings/clock/sun65iw1-r-ccu.h>
#include <dt-bindings/clock/sun65iw1-cpupll-ccu.h>
#include <dt-bindings/clock/sun65iw1-ddrpll-ccu.h>
#include <dt-bindings/clock/sunxi-ccu.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/sun4i-gpio.h>
#include <dt-bindings/reset/sun65iw1-ccu.h>
#include <dt-bindings/reset/sun65iw1-r-ccu.h>
#include <dt-bindings/power/sun65iw1-power.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/display/sunxi-lcd.h>
#include <dt-bindings/spi/sunxi-spi.h>
#include <dt-bindings/usb/pd.h>
#include "sun65iw1p1-vf.dtsi"

/ {
	model = "sun65iw1";
	interrupt-parent = <&wakeupgen>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		serial9 = &uart9;
		ir0 = &ir_rx;
		ir1 = &s_ir_rx;
		spi0 = &spi0;
		spi1 = &spi1;
		spi2 = &spi2;
		spi3 = &r_spi0;
		twi0 = &twi0;
		twi1 = &twi1;
		twi2 = &twi2;
		twi3 = &twi3;
		twi4 = &twi4;
		twi5 = &twi5;
		twi6 = &s_twi0;
		twi7 = &s_twi1;
		twi8 = &s_twi2;
		pwm0 = &pwm0;
		pwm1 = &s_pwm0;
		ethernet0 = &gmac0;
		sunxi-mmc0 = &sdc0;
		sunxi-mmc2 = &sdc2;
		gpadc0 = &gpadc0;
		ve0 = &ve;
	};

	chosen {
		bootargs = "earlyprintk=sunxi-uart,0x2500000 loglevel=8 initcall_debug=0 console=ttyS0 init=/init";
		linux,initrd-start = <0x0 0x0>;
		linux,initrd-end = <0x0 0x0>;
		rng-seed;   /* This random value should be provided by bootloader */
		kaslr-seed; /* This random value should be provided by bootloader */
	};

	reg_vdd_sys: vdd-sys {
		compatible = "regulator-fixed";
		regulator-name = "vdd_sys";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-boot-on;
		regulator-always-on;
	};

	skin_ths: skin_ths {
		compatible = "allwinner,sunxi-skin-ths";
		ext-ths-rely = <&cpub_thermal_zone>;
		#thermal-sensor-cells = <0>;
		status = "okay";
	};

	cpul_idle_ths: cpul_idle_ths {
		compatible = "allwinner,sunxi-max-temp-ths";
		ext-ths-rely = <&cpul_thermal_zone>;
		#thermal-sensor-cells = <0>;
		status = "okay";
	};

	cpum_idle_ths: cpum_idle_ths {
		compatible = "allwinner,sunxi-max-temp-ths";
		ext-ths-rely = <&cpum_thermal_zone>;
		#thermal-sensor-cells = <0>;
		status = "okay";
	};

	cpub_idle_ths: cpub_idle_ths {
		compatible = "allwinner,sunxi-max-temp-ths";
		ext-ths-rely = <&cpub_thermal_zone>;
		#thermal-sensor-cells = <0>;
		status = "okay";
	};

	/* avoid panic when memory-node err(from uboot) */
	memory@40000000 {
		device_type = "memory";
		reg = <0x00000000 0x40000000 0x00000000 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bl31 {
			reg = <0x0 0x48000000 0x0 0x01000000>;
		};

#ifdef CONFIG_AW_DRM_DYNAMIC_REGION
		/*
		 * A 150MB memory region located below the 2GB address in DDR, with 4MB-aligned addr and size.
		 * start = (0x40000000+2G-152M), size = 152M.
		 * NOTE: Keep in sync with the param 'dram_region_mbytes' in sys_config.fex.
		 */
		drm_region: cma@b6800000 {
			compatible = "shared-dma-pool", "restricted-dma-pool";
			reg = <0x0 0xb6800000 0x0 0x9800000>;
			reusable;
		};
#endif
	};

	firmware {
		android {
			compatible = "android,firmware";
			name = "android";
			boot_devices = "soc@3000000/4008000.sdmmc,soc@3000000/400a000.sdmmc,soc@3000000";
			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,vbmeta_system,vbmeta_vendor,boot,init_boot";
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

#ifdef CONFIG_AW_DRM_DYNAMIC_REGION
		drm_heap_0: drm_heap {
			compatible = "allwinner,sunxi-drm-heap-v2";
			memory-region = <&drm_region>;
		};
#endif
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x0>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_0>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU0>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <57>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x1>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_0>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU0>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x2>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_0>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU0>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;

			cpu2_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x3>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_0>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU0>;
			operating-points-v2 = <&cluster0_opp_table>;
			#cooling-cells = <2>;

			cpu3_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x100>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_1>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU1>;
			operating-points-v2 = <&cluster1_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <60>;

			cpu4_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x0 0x101>;
			enable-method = "psci";
			next-level-cache = <&A53_L2_1>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <592>;
			clocks = <&cpupll_ccu CLK_PLL_CPU1>;
			operating-points-v2 = <&cluster1_opp_table>;
			#cooling-cells = <2>;

			cpu5_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu6: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x0 0x200>;
			enable-method = "psci";
			next-level-cache = <&A73_L2>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <1024>;
			clocks = <&cpupll_ccu CLK_PLL_CPU2>;
			operating-points-v2 = <&cluster2_opp_table>;
			#cooling-cells = <2>;
			dynamic-power-coefficient = <226>;

			cpu6_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu7: cpu@201 {
			device_type = "cpu";
			compatible = "arm,cortex-a73";
			reg = <0x0 0x201>;
			enable-method = "psci";
			next-level-cache = <&A73_L2>;
			cpu-idle-states = <&CLUSTER_SLEEP_0>;
			capacity-dmips-mhz = <1024>;
			clocks = <&cpupll_ccu CLK_PLL_CPU2>;
			operating-points-v2 = <&cluster2_opp_table>;
			#cooling-cells = <2>;

			cpu7_idle: thermal-idle {
				#cooling-cells = <2>;
				duration-us = <10000>;
				exit-latency-us = <500>;
			};
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu6>;
				};
				core1 {
					cpu = <&cpu7>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			CLUSTER_SLEEP_0: cluster-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <47>;
				exit-latency-us = <74>;
				min-residency-us = <5000>;
				local-timer-stop;
			};
		};

		A53_L2_0: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
		};

		A53_L2_1: l2-cache1 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
		};

		A73_L2: l2-cache2 {
			compatible = "cache";
			cache-level = <2>;
			cache-unified;
		};
	};

	de_opp_table: opp_table {
		compatible = "operating-points-v2";

		opp@50000000 {
			opp-hz = /bits/ 64 <50000000>;
			opp-microvolt = <900000>;
		};

		opp@600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <900000>;
		};
	};

	thermal_zones: thermal-zones {
		cpul_thermal_zone: cpul_thermal_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 0>;
			sustainable-power = <504>;

			cpul_trips: trips {
				cpul_threshold: trip-point@0 {
					temperature = <70000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpul_target: trip-point@1 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpul_crit: cpu_crit@0 {
					temperature = <110000>;
					type = "critical";
					hysteresis = <0>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpul_target>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		cpum_thermal_zone: cpum_thermal_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 1>;
			sustainable-power = <210>;

			cpum_trips: trips {
				cpum_threshold: trip-point@0 {
					temperature = <70000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpum_target: trip-point@1 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpum_crit: cpu_crit@0 {
					temperature = <110000>;
					type = "critical";
					hysteresis = <0>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpum_target>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		cpub_thermal_zone: cpub_thermal_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 2>;
			sustainable-power = <914>;

			cpub_trips: trips {
				cpub_threshold: trip-point@0 {
					temperature = <70000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpub_target: trip-point@1 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpub_crit: cpu_crit@0 {
					temperature = <110000>;
					type = "critical";
					hysteresis = <0>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpub_target>;
					cooling-device = <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		gpu_thermal_zone: gpu_thermal_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 3>;

			gpu_trips: trips {
				gpu_threshold: trip-point@0 {
					temperature = <70000>;
					type = "passive";
					hysteresis = <0>;
				};
				gpu_target: trip-point@1 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <0>;
				};
				gpu_crit: gpu_crit@0 {
					temperature = <110000>;
					type = "critical";
					hysteresis = <0>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu_threshold>;
					cooling-device = <&gpu 0 0>;
					contribution = <1024>;
				};
				map1 {
					trip = <&gpu_target>;
					cooling-device = <&gpu 0 THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
				map2 {
					trip = <&gpu_crit>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
					contribution = <1024>;
				};
			};
		};

		ddr_thermal_zone: ddr_thermal_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&ths 4>;

			ddr_trips: trips {
				ddr_crit: ddr_crit@0 {
					temperature = <110000>;
					type = "critical";
					hysteresis = <0>;
				};
			};
		};

		skin_zone: skin_zone {
			polling-delay-passive = <0>;
			polling-delay = <0>;
			thermal-sensors = <&skin_ths>;

			skin_trips: trips {
				skin_crit: skin_crit@0 {
					temperature = <50000>;
					type = "critical";
					hysteresis = <0>;
				};
			};
		};

		cpul_idle_zone: cpul_idle_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&cpul_idle_ths>;

			cpul_idle_trips: trips {
				cpul_thres: trip-point@0 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpul_overshot: trip-point@1{
					temperature = <100000>;
					type = "passive";
					hysteresis = <2000>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpul_overshot>;
					cooling-device = <&cpu2_idle 0 50>,
							 <&cpu3_idle 0 50>;
					contribution = <1024>;
				};
			};
		};

		cpum_idle_zone: cpum_idle_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&cpum_idle_ths>;

			cpum_idle_trips: trips {
				cpum_thres: trip-point@0 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpum_overshot: trip-point@1{
					temperature = <100000>;
					type = "passive";
					hysteresis = <2000>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpum_overshot>;
					cooling-device = <&cpu4_idle 0 50>,
							 <&cpu5_idle 0 50>;
					contribution = <1024>;
				};
			};
		};

		cpub_idle_zone: cpub_idle_zone {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&cpub_idle_ths>;

			cpub_idle_trips: trips {
				cpub_thres: trip-point@0 {
					temperature = <90000>;
					type = "passive";
					hysteresis = <2000>;
				};
				cpub_overshot: trip-point@1{
					temperature = <100000>;
					type = "passive";
					hysteresis = <2000>;
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpub_overshot>;
					cooling-device = <&cpu6_idle 0 100>,
							 <&cpu7_idle 0 100>;
					contribution = <1024>;
				};
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	dcxo24M: dcxo24M_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "dcxo24M";
	};

	rc_16m: rc16m_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <16000000>;
		clock-accuracy = <300000000>;
		clock-output-names = "rc-16m";
	};

	ext_32k: ext32k_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "ext-32k";
	};

	gic: interrupt-controller@8001000{
		compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		device_type = "gic";
		interrupt-controller;
		reg = <0x0 0x08001000 0 0x1000>, /* GIC Dist */
			<0x0 0x08002000 0 0x2000>, /* GIC CPU */
			<0x0 0x08004000 0 0x2000>, /* GIC VCPU Control */
			<0x0 0x08006000 0 0x2000>; /* GIC VCPU */
		interrupts = <GIC_PPI 9 0xf04>; /* GIC Maintenence IRQ */
		interrupt-parent = <&gic>;
	};

	wakeupgen: interrupt-controller@0 {
		compatible = "allwinner,sunxi-wakeupgen";
		interrupt-controller;
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-parent = <&gic>;
	};

	timer_arch {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
		clock-frequency = <24000000>;
		interrupt-parent = <&gic>;
		arm,no-tick-in-suspend;
	};

	nmi_intc: intc-nmi@7030320 {
		compatible = "allwinner,sun8i-nmi";
		interrupt-parent = <&gic>;
		#interrupt-cells = <2>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x0 0x07030320 0 0xc>;
		interrupts = <GIC_SPI 224 IRQ_TYPE_LEVEL_HIGH>;
	};

	mmu_aw: iommu@2000000 {
		compatible = "allwinner,iommu-v3";
		reg = <0x0 0x02000000 0x0 0x1000>;
		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "iommu-irq";
		clocks = <&ccu CLK_BUS_IOMMU_APB>;
		clock-names = "iommu";
		/* clock-frequency = <24000000>; */
		#iommu-cells = <2>;
		version=<0x17>;
		tlb_prefetch = <0x3007f>;
		tlb_invalid_mode = <0x1>;
		ptw_invalid_mode = <0x1>;
		masters = "ISP", "CSI", "VE0", "Eink", "G2D",
			"DE", "RESERVED", "DEBUG_MODE";
		valid_masters=<7>;
	};

	pck: pck-600@7060000 {
		compatible = "allwinner,sun65iw1-pck", "syscon", "simple-mfd";
		reg = <0x0 0x07060000 0x0 0x8000>;

		pd: power-controller {
			compatible = "allwinner,sun65iw1-pck-600";
			clocks = <&r_ccu CLK_BUS_R_PPU_VO0>;
			clock-names = "pck";
			#power-domain-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			pd_vo@SUN65IW1_PCK_VO {
				reg = <SUN65IW1_PCK_VO>;
			};

			pd_ve@SUN65IW1_PCK_VE {
				reg = <SUN65IW1_PCK_VE>;
			};

			pd_vi@SUN65IW1_PCK_VI {
				reg = <SUN65IW1_PCK_VI>;
			};

			pd_hsi@SUN65IW1_PCK_HSI {
				reg = <SUN65IW1_PCK_HSI>;
			};
		};
	};

	dram: dram {
		/* for uboot update dram para */
		dram_para00 = <0x00000000>;
		dram_para01 = <0x00000000>;
		dram_para02 = <0x00000000>;
		dram_para03 = <0x00000000>;
