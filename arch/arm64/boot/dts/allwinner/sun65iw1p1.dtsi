			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s0_plat>;
			};
			soundcard-mach,codec {
			};
		};

		i2s1_plat:i2s1_plat@2901000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02901000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S1>;
			clocks		= <&ccu CLK_BUS_I2S1_APB>,
					  <&ccu CLK_PLL_PERI0_200M>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_AUDIO1_2X>,
					  <&ccu CLK_PLL_AUDIO1_5X>,
					  <&ccu CLK_I2S1>;
			clock-names	= "clk_bus_i2s",
