		usbc0: usbc0@10 {
			device_type = "usbc0";
			compatible = "allwinner,sunxi-otg-manager";
			reg = <0x0 0x10 0x0 0x1000>;
			usb_port_type = <2>;
			usb_detect_type = <1>;
			usb_detect_mode = <0>;
			usb_id_gpio;
			usb_det_vbus_gpio;
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0>;
			usb_luns = <3>;
			usb_serial_unique = <0>;
			usb_serial_number = "20080411";
			rndis_wceis = <1>;
			status = "disabled";
		};

		udc:udc-controller@c100000 {
			compatible = "allwinner,sunxi-udc";
			reg = <0x0 0x0c100000 0x0 0x1000>, /* udc base */
			      <0x0 0x00000000 0x0 0x100>;  /* sram base */
			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_DEV_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_otg", "usb_sys_ahb";
			resets = <&ccu RST_USB0_DEV>, <&ccu RST_USB2P0_SY>;
			reset-names = "otg", "usb_rst";
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			aw,dma_addr_extend;
			aw,dma_wordaddr_bypass = <0x1>;
			status = "disabled";
		};

		ehci0:ehci0-controller@c101000 {
			compatible = "allwinner,sunxi-ehci0";
			reg = <0x0 0x0c101000 0x0 0xFFF>,  /*hci0 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x0c100000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_EHCI_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "usb_sys_ahb";
			resets = <&ccu RST_USB0_EHCI>,  <&ccu RST_USB2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <0>;
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		ohci0:ohci0-controller@c101400 {
			compatible = "allwinner,sunxi-ohci0";
			reg = <0x0 0x0c101400 0x0 0xFFF>,  /*hci0 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x0c100000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_OHCI_AHB>, <&ccu CLK_BUS_USB0>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "ohci", "usb_sys_ahb";
			resets = <&ccu RST_USB0_OHCI>, <&ccu RST_USB2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <0>;
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		usbc1: usbc1@11 {
			device_type = "usbc1";
			reg = <0x0 0x11 0x0 0x1000>;
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0>;
			status = "disabled";
		};

		ehci1: ehci1-controller@c200000 {
			compatible = "allwinner,sunxi-ehci1";
			reg = <0x0 0x0c200000 0x0 0xFFF>,  /*ehci1 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x0c100000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB1_EHCI_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "usb_sys_ahb";
			resets = <&ccu RST_USB1_EHCI>, <&ccu RST_USB2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <1>;
			phys = <&u2phy1>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		ohci1: ohci1-controller@c200400 {
			compatible = "allwinner,sunxi-ohci1";
			reg = <0x0 0x0c200400 0x0 0xFFF>,  /*ohci1 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x0c100000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB1_OHCI_AHB>, <&ccu CLK_BUS_USB1>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "ohci", "usb_sys_ahb";
			resets = <&ccu RST_USB1_OHCI>, <&ccu RST_USB2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <1>;
			phys = <&u2phy1>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		usbc2:usbc2@12 {
			device_type = "usbc2";
			compatible = "allwinner,sunxi-plat-dwc3";
			reg = <0x0 0x12 0x0 0x1000>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			xhci2: xhci2-controller@c400000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x0c400000 0x0 0x100000>;
				interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>;
				dr_mode = "otg"; // dr_mode option: host, peripheral, otg
				clocks = <&ccu CLK_USB2_REF>, <&ccu CLK_BUS_USB2_U2_PHY_REF>, <&ccu CLK_USB2_SUSPEND>;
				clock-names = "bus_clk", "ref_clk", "suspend";
				assigned-clocks = <&ccu CLK_USB2_SUSPEND>;
				assigned-clock-rates = <24000000>;
				resets = <&ccu RST_USB2>;
				reset-names = "hci";
				maximum-speed = "super-speed";
				phy_type = "utmi";
				snps,dis_enblslpm_quirk;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				snps,dis_u3_susphy_quirk;
				snps,dis_u2_susphy_quirk;
				phys = <&u2phy2>, <&combo0_usb3>;
				phy-names = "usb2-phy", "usb3-phy";
				status = "disabled";
			};
		};

		synopsys: synopsys@dc80000 {
			compatible = "allwinner,synopsys-combophy-v2";
			reg = <0x0 0x0dc80000 0x0 0x8000>, /* HSI Subsystem Application Register */
			      <0x0 0x0dd00000 0x0 0x100>, /* COMBO0 PHY TOP Application Register */
			      <0x0 0x0dd01000 0x0 0x10>, /* COMBO0 PHY CORE Application Register */
			      <0x0 0x03200184 0x0 0x4>; /* EXT HSI_COMBO RES ohms Registers */
			clocks = <&ccu CLK_BUS_HSI_AHB_SW>, <&ccu CLK_HSI_AXI>,
				 <&ccu CLK_BUS_HSI_AHB>, <&ccu CLK_BUS_HSI_AXI>;
			clock-names = "bus_clk", "axi_clk",
				      "ahb_bus_clk", "axi_bus_clk";
			assigned-clocks = <&ccu CLK_HSI_AXI>;
			assigned-clock-rates = <600000000>;
			resets = <&ccu RST_BUS_HSI_SY>;
			reset-names = "reset";
			power-domains = <&pd SUN65IW1_PCK_HSI>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			sid = <&sid>;
			sid-res = "res1";
			status = "disabled";

			combo0_usb3: combo-usb3 {
				clocks = <&ccu CLK_HSI_COMB0_PHY_REF>, <&ccu CLK_HSI_COMB0_PHY_CFG>,
					 <&ccu CLK_USB2_U3_ONLY_UTMI>;
				clock-names = "comb0_ref_clk", "comb0_cfg_clk", "u3_only_clk";
				#phy-cells = <0>;
				status = "okay";
			};

			combo0_pcie: combo-pcie {
				clocks = <&ccu CLK_HSI_COMB0_PHY_REF>, <&ccu CLK_HSI_COMB0_PHY_CFG>;
				clock-names = "comb0_ref_clk", "comb0_cfg_clk";
				#phy-cells = <0>;
				status = "okay";
			};
		};

		u2phy: phy@c000000 {
			compatible = "allwinner,sunxi-awphy-v100";
			reg = <0x0 0x0c000000 0x0 0x100>, /* PHY Application Registers */
			      <0x0 0x0c080000 0x0 0x100>, /* Digital Application Registers */
			      <0x0 0x03200178 0x0 0x4>; /* INT USB RES ohms Registers */
			reg-names = "phy_base", "top_base", "res_base";
			clocks = <&ccu CLK_BUS_HSI_AHB>, <&ccu CLK_BUS_HSI_AHB_SW>;
			clock-names = "mclk", "pclk";
			resets = <&ccu RST_BUS_HSI_SY>, <&ccu RST_USB2P0_SY>;
			reset-names = "rst", "usb_rst";
			#phy-cells = <0>;
			sid = <&sid>;
			sid-res = "res0";
			status = "disabled";

			u2phy0: u2-phy0 {
				clocks = <&ccu CLK_BUS_USB2P0_SYS_PHY_REF>;
				clock-names = "ref_clk";
				dpdm-bypass-quirk = <0x02 0xb2 0x00 0x01
						     0x02 0xb8 0x01 0x01
						     0x02 0xb9 0x01 0x01
						     0x02 0xba 0x00 0x01
						     0x02 0xbb 0x01 0x01>;
				#phy-cells = <0>;
				status = "okay";
			};

			u2phy1: u2-phy1 {
				clocks = <&ccu CLK_BUS_USB2P0_SYS_PHY_REF>;
				clock-names = "ref_clk";
				#phy-cells = <0>;
				status = "okay";
			};

			u2phy2: u2-phy2 {
				clocks = <&ccu CLK_BUS_USB2P0_SYS_PHY_REF>, <&ccu CLK_USB2_U2_ONLY_PIPE>;
				clock-names = "ref_clk", "u2_only_clk";
				dpdm-bypass-quirk = <0x02 0xb2 0x00 0x01
						     0x02 0xb8 0x01 0x01
						     0x02 0xb9 0x01 0x01
						     0x02 0xba 0x00 0x01
						     0x02 0xbb 0x01 0x01>;
				#phy-cells = <0>;
				status = "okay";
			};
		};

		rfkill: rfkill {
			compatible = "allwinner,sunxi-rfkill";
			status = "disabled";
		};

		addr_mgt: addr_mgt {
			compatible = "allwinner,sunxi-addr_mgt";
			status = "disabled";
		};

		btlpm: btlpm {
			compatible = "allwinner,sunxi-btlpm";
			status = "disabled";
		};

		timestamp: timestamp@8220000 {
			compatible = "allwinner,timestamp";
			reg = <0x0 0x08220000 0x0 0x8>;
			clocks = <&dcxo24M>;
			clock-names = "hosc";
			status = "okay";
		};
	};
};
