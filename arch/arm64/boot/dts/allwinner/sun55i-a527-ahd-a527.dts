	wait_data_time_ns = <600000>;
	status = "disabled";
};
/*twi0 only connect mipi lcd,embfly*/
&twi0 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi0_pins_default>;
	pinctrl-1 = <&twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	/* For stability and backwards compatibility, we recommend setting ‘twi_drv_used’ to 1 */
	twi_drv_used = <1>;
	twi-supply = <&reg_dcdc4>;
	status = "okay";

	eeprom@50 {
		compatible = "atmel,24c16";
		reg = <0x50>;
		status = "disabled";
	};
	pcie_usb_phy@74 {
		compatible = "combphy,phy74";
		reg = <0x74>;
		status = "disabled";
	};
	pcie_usb_phy@75 {
		compatible = "combphy,phy75";
		reg = <0x75>;
		status = "disabled";
	};

	ctp {
		compatible = "allwinner,goodix";
		reg = <0x5d>;
		device_type = "ctp";
		status = "disabled";
		ctp_name = "gt9xxnew_ts";
		ctp_twi_id = <0x0>;
		ctp_twi_addr = <0x5d>;
		ctp_screen_max_x = <0x400>;/*1024*/
		ctp_screen_max_y = <0x258>;/*600*/
		ctp_revert_x_flag = <0x1>;
		ctp_revert_y_flag = <0x1>;
		ctp_exchange_x_y_flag = <0x0>;
		ctp_int_port = <&pio PD 20 GPIO_ACTIVE_LOW>;/* ctp int */
		ctp_wakeup = <&pio PD 21 GPIO_ACTIVE_LOW>;/* ctp reset*/
		ctp-supply = <&reg_cldo2>;
		ctp_power_ldo_vol = <3300>;
	};

#ifdef USE_MIPI_DSI1_1024_600
	/* DSI TOUCH CONFIG */
	gt9xx {
		compatible = "goodix,gt9xx";
		reg = <0x5d>;
		status = "okay";
		irq-gpios = <&pio PD 20 GPIO_ACTIVE_LOW>; /*ctp int */
//		goodix_irq_gpio = <&pio PD 20 GPIO_ACTIVE_LOW>; /* ubuntu config */
		irq-flags = <2>;
		reset-gpios = <&pio PD 21 GPIO_ACTIVE_LOW>;/* ctp reset*/
	//	goodix_rst_gpio = <&pio PD 21 GPIO_ACTIVE_LOW>;/* ubuntu config */
		vdd_ana-supply = <&reg_dcdc4>;

		touchscreen-max-id = <11>;
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <600>;
		touchscreen-max-w = <512>;
		touchscreen-max-p = <512>;
		//touchscreen-key-map = <172>, <158>; /*KEY_HOMEPAGE=172, KEY_BACK=158，KEY_MENU=139*/
		goodix,slide-wakeup = <0>;
		goodix,type-a-report = <1>;
		goodix,driver-send-cfg = <0>;
		goodix,send-cfg-id = <0>;
		goodix,resume-in-workqueue = <0>;
		goodix,int-sync = <1>;
		goodix,revert_x = <0>;
		goodix,revert_y = <0>;
		goodix,swap-x2y = <0>;
		goodix,tp_idle_support = <1>;
		goodix,esd-protect = <1>;
		goodix,auto-update-cfg = <0>;
