&rfkill {
	compatible = "allwinner,sunxi-rfkill";
	chip_en;
	power_en;
	pinctrl-0;
	pinctrl-names;
	status = "okay";

	/* wlan session */
	wlan {
		compatible    = "allwinner,sunxi-wlan";
    	clocks        = <&rtc_ccu CLK_OSC32K_OUT>;/*internal 32k used,embfly*/
		clock-names   = "osc32k-out";/*internal 32k used,embfly*/
		/* wifi vcc-vbat always powered by vcc-pl,
		vcc-pl/vcc-pg/vcc-pm */
		/*wlan_power    = "axp2202-aldo3", "axp2202-bldo1"; */
		/* wifi vcc-vbat powered by dcdc4,vcc-pg/vcc-pm */
		wlan_power    = "axp2202-dcdc4", "axp2202-bldo1"; 
		wlan_power_vol= <3300000>, <1800000>;
		wlan_busnum   = <0x1>;
		wlan_regon    = <&r_pio PM 1 GPIO_ACTIVE_HIGH>;
		wlan_hostwake = <&r_pio PM 0 GPIO_ACTIVE_HIGH>;
		wakeup-source;
	};

	/* bt session */
	bt {
		compatible    = "allwinner,sunxi-bt";
		clocks        = <&rtc_ccu CLK_OSC32K_OUT>;/*internal 32k used,embfly*/
		clock-names   = "osc32k-out";/*internal 32k used,embfly*/
		/* wifi vcc-vbat always powered by vcc-pl,
		vcc-pl/vcc-pg/vcc-pm */
		/*bt_power    = "axp2202-aldo3", "axp2202-bldo1"; */
		/* wifi vcc-vbat powered by dcdc4,vcc-pg/vcc-pm */
		bt_power    = "axp2202-dcdc4", "axp2202-bldo1"; 
		bt_power_vol= <3300000>, <1800000>;
		bt_rst_n      = <&r_pio PM 2 GPIO_ACTIVE_LOW>;
	};
};

&addr_mgt {
	compatible     = "allwinner,sunxi-addr_mgt";
	type_addr_wifi = <0x0>;
	type_addr_bt   = <0x0>;
	type_addr_eth  = <0x0>;
	status         = "okay";
};

&btlpm {
	compatible  = "allwinner,sunxi-btlpm";
	uart_index  = <0x1>;
	bt_wake     = <&r_pio PM 3 GPIO_ACTIVE_HIGH>;
	bt_hostwake = <&r_pio PM 4 GPIO_ACTIVE_HIGH>;
	wakeup-source;
	status      = "okay";
};

/*
 *usb_port_type: usb mode. 0-device, 1-host, 2-otg.
 *usb_detect_type: usb hotplug detect mode. 0-none, 1-vbus/id detect, 2-id/dpdm detect.
 *usb_detect_mode: 0-thread scan, 1-id gpio interrupt.
 *usb_id_gpio: gpio for id detect.
 *usb_det_vbus_gpio: gpio for id detect. gpio or "axp_ctrl";
 *usb_wakeup_suspend：0-SUPER_STANDBY, 1-USB_STANDBY.
 */
/* Update-USB0-CONFIG*/
&usbc0 {
	device_type = "usbc0";
	usb_port_type = <0x2>;
	usb_detect_type = <0x1>;
	usb_detect_mode = <0x0>;
	usb_id_gpio = <&pio PB 6 GPIO_ACTIVE_HIGH>;/*embfly,fixed*/
	enable-active-high;
	usb_det_vbus_gpio = <&pio PB 5 GPIO_ACTIVE_HIGH>;/*embfly,fixed*/
	enable-active-high;
	detvbus_io-supply = <&reg_cldo3>;/*usb_det_vbus_gpio power supply,embfly,fixed*/
	usb_regulator_io = "nocare";
	usb_wakeup_suspend = <0>;
	usb_luns = <3>;
	usb_serial_unique = <0>;
	usb_serial_number = "20080411";
	rndis_wceis = <1>;
	status = "okay";
};

&udc {
	/*det_vbus_supply used,
	when usb_det_vbus_gpio=”axp_ctrl”*/
	/*det_vbus_supply = <&usb_power_supply>;*/
	phy_range = <0x153>;
	status = "okay";/*need debug,embfly*/
};

&ehci0 {
	drvvbus-supply = <&reg_usb0_vbus>;
	phy_range = <0x153>;
	status = "okay";
};

&ohci0 {
	drvvbus-supply = <&reg_usb0_vbus>;
	phy_range = <0x153>;
	status = "okay";
};

/* USB20 HUB CONFIG */
&usbc1 {
	device_type = "usbc1";
	usb_regulator_io = "nocare";
	usb_wakeup_suspend = <0>;/*not support wakeup*/
	status = "okay";
};

&ehci1 {
	drvvbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};

&ohci1 {
	drvvbus-supply = <&reg_usb1_vbus>;
	status = "okay";
};

/* USB3.0 CONFIG*/
&usbc2 {
	device_type = "usbc2";
	drvvbus-supply = <&reg_usb2_vbus>;/*reg_drivevbus*/
	/* 若配置此项，则drvvbus‑supply不生效，
	与其他端口共用vbus。*/
	/*aw,vbus-shared-quirk;*/
	status = "okay";
};

&xhci2 {
	dr_mode = "host";
	status = "okay";
};

&u2phy {
	status = "okay";
};

/*set USB3.0 mode,AHD-X527,embfly*/
&combophy {
	resets = <&ccu RST_BUS_PCIE_USB3>;
	phy_use_sel = <1>; /* 0:PCIE; 1:USB3 */
	status = "okay";
};

&pcie {
	reset-gpios = <&pio PH 11 GPIO_ACTIVE_HIGH>;
	wake-gpios = <&pio PH 12 GPIO_ACTIVE_HIGH>;
	pcie1v8-supply = <&reg_bldo3>;
	pcie3v3-supply = <&reg_dcdc4>;
	status = "okay";
 };

&gpu {
	gpu_idle = <1>;
	dvfs_status = <1>;
	mali-supply = <&reg_dcdc2>;
};

