	leds {
		compatible = "gpio-leds";
		status = "okay";/*fixed,embfly*/

		led@0 {/*AHD-X527,embfly*/
				label = "runled";
				gpios = <&pio PK 10 GPIO_ACTIVE_HIGH>;
				linux,default-trigger = "heartbeat";
			};
#if 0
		led@1 {
				label = "user-led0";
				gpios = <&pio PB 7 GPIO_ACTIVE_HIGH>;
				default-state = "on";
			};
#endif			
		};

	gpio-keys {
		compatible = "gpio-keys";
		autorepeat;
		status = "disabled";/*fixed,embfly*/

		user_key@0 {
			label = "user-key0";
			linux,code = <202>; /* USER KEY*/				
			gpios = <&pio PB 12 GPIO_ACTIVE_LOW>;
			};
		};
	/*no awlink for a527,embfly*/
	awlink0: awlink@0x0{
		pinctrl-names = "default";
        	pinctrl-0 = <&awlink0_pins_a>;
      	 	pinctrl-1 = <&awlink0_pins_b>;
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "allwinner,t527-awlink";
		device_type = "awlink0";
		awlink-pin = <1>;
		id = <0>;
		status = "disabled";
		};

	awlink1: awlink@0x1{
		pinctrl-names = "default";
                pinctrl-0 = <&awlink1_pins_a>;
                pinctrl-1 = <&awlink1_pins_b>;
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "allwinner,t527-awlink";
		device_type = "awlink1";
		awlink-pin = <0>;
		id = <1>;
		status = "disabled";
	};
};

&de {
	chn_cfg_mode = <3>;
	status = "okay";
};

&vo0 {
	status = "okay";
};

